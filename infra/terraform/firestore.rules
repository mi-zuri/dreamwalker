rules_version = '2';

// The game server talks to Firestore as an admin and is not subject to this.
// Nothing else is allowed in at all - no client, signed in or not, has any
// business reading another player's runs or the shared event pool.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
