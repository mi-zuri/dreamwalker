# Vertex AI (text + images) uses ADC / the Cloud Run service account - no key here.
GCP_PROJECT=
GCP_LOCATION=global

# Lyria RealTime is Gemini-API-only and needs its own key (Secret Manager in prod).
GEMINI_API_KEY=

# live | mock | fake
#   mock - replays four recorded games; never runs the pipeline, spends nothing
#   fake - runs the real pipeline against a synthetic model; spends nothing
#   live - Vertex AI
LLM_MODE=mock
# fixture | generated - under LLM_MODE=mock, "generated" swaps the recorded
# grid for a freshly generated floor plan so the map generator can be walked.
MOCK_MAP_SOURCE=fixture
# realtime | loops
MUSIC_MODE=realtime

# dev | firebase - "dev" treats every caller as one local user; deployment uses "firebase".
AUTH_MODE=dev
# Invite-only is the strongest cost control we have; comma-free JSON list.
INVITE_ONLY=false
ALLOWED_EMAILS=[]

# memory | firestore - "memory" keeps games in-process and is lost on restart.
STORAGE_MODE=memory
# memory | gcs - where generated images live. "memory" serves them from this
# process, which is correct locally and wrong behind more than one instance.
ASSETS_MODE=memory
ASSETS_BUCKET=

# Vertex allows two image generations per minute per project by default. The
# pipeline paces itself to this; set it to 0 to disable the limiter entirely.
IMAGE_RPM=2

# News ingest is lazy. A News game refreshes its region's pool only when the
# pool is thinner or older than these, which is why an idle month costs nothing.
POOL_MAX_AGE_HOURS=6
POOL_MIN_PLAYABLE=12

# Hard month-to-date spend cap in USD, checked before every generation.
MONTHLY_BUDGET_USD=2.40
